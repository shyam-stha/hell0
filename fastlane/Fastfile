default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 0. Authenticate with App Store Connect API (Bypasses 2FA for CI/CD)
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: true,
      in_house: false
    )

    # 1. Automatically fetch the provisioning profiles from your secure certificates repo
    # setup_ci
    # match(type: "appstore", app_identifier: ENV['BUNDLE_ID'], readonly: true)
    
    # 2. Build the Xcode project dynamically
    build_app(
      workspace: "../ios/App/App.xcworkspace", 
      scheme: "App",
      export_method: "app-store"
    )
    
    # 3. Upload the resulting .ipa to Apple App Store Connect
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
